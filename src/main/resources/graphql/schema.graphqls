scalar DateTime
scalar Long

type ArticleResponse {
  id: ID!
  title: String
  content: String
  createdAt: DateTime
  updatedAt: DateTime
}

type ArticlePageResponse {
  content: [ArticleResponse!]!
  page: Int!
  size: Int!
  totalElements: Long!
  totalPages: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
}

input ArticleRequest {
  title: String!
  content: String!
}

type Query {
  articles(page: Int = 0, size: Int = 10): ArticlePageResponse!
  article(id: ID!): ArticleResponse
}

type Mutation {
  createArticle(input: ArticleRequest!): ArticleResponse!
  updateArticle(id: ID!, input: ArticleRequest!): ArticleResponse!
  deleteArticle(id: ID!): Boolean!
}